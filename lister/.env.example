# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB — ex. Atlas: Connect → Drivers → connection string
# DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/lister?retryWrites=true&w=majority
DATABASE_URL=

# Opțional: acest email primește rol admin la primul login (cont trebuie să existe în Clerk)
DEFAULT_ADMIN_EMAIL=

# Opțional: emailuri (virgulă) care primesc automat rol staff la primul login
# STAFF_ALLOWED_EMAILS=voluntar1@exemplu.ro,voluntar2@exemplu.ro

# Recomandat în producție: secret dedicat pentru cookie-ul de înscriere publică (/e/*)
# REGISTRATION_SESSION_SECRET=

# În Clerk Dashboard: dezactivează înregistrarea publică dacă nu vrei conturi noi.
# Utilizatorii fără rol primesc „pending” și nu văd date participanți.

# SMTP pentru trimiterea codurilor QR pe email (UI admin + scripts/send-qr-emails.mjs)
#
# Regula importantă: SMTP_USER trebuie să fie contul cu care te autentifici.
# SMTP_FROM poate fi altă adresă DOAR dacă acel cont are dreptul să trimită „ca” ea
# (alias / „Send mail as” în Gmail, sau SMTP relay în Google Workspace).
#
# Variante uzuale:
# 1) Cont Gmail personal dedicat balului (ex. bal.liceu@gmail.com) + App Password
# 2) Cont Google Workspace separat pe domeniul tău (ex. bal@scoala.ro) — adminul îl creează
# 3) Brevo/SendGrid cu domeniu verificat — trimiți de pe orice @domeniul-tău fără Workspace pe acel inbox
#
# Gmail / Google Workspace SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=bal@domeniul-tau.ro
# SMTP_PASS=parola-de-aplicatie-16-caractere
# SMTP_FROM="Bal Automatica <bal@domeniul-tau.ro>"
